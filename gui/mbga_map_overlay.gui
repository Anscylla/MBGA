# Buttons drawn over the provinces themselves.
#
# Province.GetScreenPosition gives a province its coordinates on screen and position
# accepts a data expression; neither is used together anywhere in the base game.
#
# widgetanchor centres a button on the point it is given rather than measuring from the
# middle of the screen. The remaining drift grew with the distance from the anchor, which
# is a scale factor, so the layer carries the inverse of its parent's scale.
# Multiply_CVector2f will not take a float, hence correcting through scale instead.
#
# One button per province, never three stacked. Three overlapping buttons meant the
# invisible ones still swallowed the pointer, which is why an already taken province
# could not be clicked again to hand it back. State is shown by icons laid on top of the
# single button, all of them transparent to the mouse.
widget = {
	name = "mbga_map_overlay"
	layer = layer_map_markers
	widgetanchor = top|left
	size = { 100% 100% }
	alwaystransparent = yes
	datacontext = "[AccessMetaPlayer.AccessPlayedOrObservedCountry]"

	# Only that there is a player. Asking a scripted gui about GetPlayer up here means
	# asking it on the main menu and through every loading screen, which was two hundred
	# errors before a single province had been looked at. The real question is one level
	# in, where it is asked only once this widget is showing.
	visible = "[GetMetaPlayer.GetPlayedOrObservedCountry.IsValid]"

	widget = {
		size = { 100% 100% }
		scale = "[GetInvParentScale(PdxGuiWidget.Self)]"
		alwaystransparent = no
		visible = "[And( IsZoomLevelNear, GetScriptedGui('mbga_has_target_country').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End) )]"
		datamodel = "[GetGlobalList('mbga_candidates')]"

		item = {
			button = {
				datacontext = "[Scope.GetScriptContainer]"
				position = "[ScriptContainer.MakeScope.Var('mbga_province').GetProvince.GetScreenPosition]"
				widgetanchor = center
				size = { 40 40 }
				using = default_button
				using = clickthrough_blocker
				alwaystransparent = no
				enabled = "[Not(GetScriptedGui('mbga_container_blocked').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).End))]"
				visible = "[Not(GetScriptedGui('mbga_container_own_from_start').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).End))]"
				onclick = "[GetScriptedGui('mbga_take_container').Execute(GuiScope.SetRoot(ScriptContainer.MakeScope).AddScope('actor', GetPlayer.MakeScope).End)]"

				textbox = {
					parentanchor = center
					size = { 36 36 }
					align = center|nobaseline
					text = "MBGA_MAP_TAKEN"
					visible = "[GetScriptedGui('mbga_container_taken').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).End)]"
					alwaystransparent = yes
				}
				textbox = {
					parentanchor = center
					size = { 36 36 }
					align = center|nobaseline
					text = "MBGA_MAP_BLOCKED"
					visible = "[GetScriptedGui('mbga_container_blocked').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).End)]"
					alwaystransparent = yes
				}
				textbox = {
					parentanchor = center
					size = { 36 36 }
					align = center|nobaseline
					text = "MBGA_MAP_FREE"
					visible = "[And( Not(GetScriptedGui('mbga_container_taken').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).End)), Not(GetScriptedGui('mbga_container_blocked').IsShown(GuiScope.SetRoot(ScriptContainer.MakeScope).End)) )]"
					alwaystransparent = yes
				}
			}
		}
	}
}
