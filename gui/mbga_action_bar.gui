# The whole interface of the diplomatic route: which state is open, and a button to stop.
# Everything else happens on the map.

widget = {
	name = "mbga_action_bar"
	layer = layer_ingame_menu
	size = { 100% 100% }
	allow_outside = yes
	alwaystransparent = yes
	visible = "[GetMetaPlayer.GetPlayedOrObservedCountry.IsValid]"
	datacontext = "[AccessMetaPlayer.AccessPlayedOrObservedCountry]"

	window = {
		name = "mbga_action_bar_window"
		layer = popups
		allow_outside = yes
		alwaystransparent = no
		movable = yes
		using = clickthrough_blocker

		size = { 280 62 }
		parentanchor = top|hcenter
		position = { 0 90 }
		visible = "[And( GetScriptedGui('mbga_tool_is_on').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('mbga_has_target_country').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End) )]"

		icon = {
			texture = "gfx/interface/backgrounds/entry_bg_simple_solid.dds"
			size = { 100% 100% }
			alwaystransparent = yes
		}
		background = { using = entry_bg_simple }

		textbox = {
			text = "MBGA_BAR_TAKEN"
			default_format = "#header"
			position = { 10 8 }
			size = { 260 20 }
			alwaystransparent = yes
		}

		textbox = {
			text = "MBGA_SETTLE_INFAMY"
			position = { 150 8 }
			size = { 120 20 }
			alwaystransparent = yes
			visible = "[GetScriptedGui('mbga_is_settling').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		button = {
			text = "MBGA_BAR_DONE"
			using = default_button
			size = { 90 20 }
			position = { 10 34 }
			onclick = "[GetScriptedGui('mbga_close_tool').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		# The camera cannot be sent to a province, so this is as close as the interface gets.
		button = {
			text = "MBGA_GOTO_STATE"
			using = default_button
			size = { 74 20 }
			position = { 110 34 }
			datacontext = "[GetPlayer.MakeScope.Var('mbga_active_state').GetState]"
			onclick = "[State.ZoomExtraCloseToCapital]"
		}
	}
}
