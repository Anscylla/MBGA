# The debug panel: country list, state list, province rows and a window of numbers.
#
# Shown under the mbga_province_tool_debug game rule. Mounted through
# gui/scripted_widgets, so no base game file is touched.

widget = {
	name = "mbga_probe_panel"
	layer = layer_ingame_menu
	size = { 100% 100% }
	allow_outside = yes
	alwaystransparent = yes
	visible = "[GetMetaPlayer.GetPlayedOrObservedCountry.IsValid]"
	datacontext = "[AccessMetaPlayer.AccessPlayedOrObservedCountry]"

	widget = {
		size = { 0 0 }
		alpha = 0
		allow_outside = yes
		visible = "[And3( GetScriptedGui('mbga_has_target_country').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(TimeKeeper.IsPaused), TimeKeeper.CanTogglePause )]"
		state = {
			name = _show
			on_start = "[TimeKeeper.TogglePause]"
		}
	}

	window = {
		name = "mbga_window"
		layer = popups
		allow_outside = yes
		alwaystransparent = no
		movable = yes
		using = clickthrough_blocker

		size = { 300 620 }
		parentanchor = top|right
		position = { -520 80 }

		visible = "[GetScriptedGui('mbga_tool_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

		# entry_bg_simple is a translucent frame, so the map reads straight through it.
		# A solid plate goes underneath, the way the State Transfer Tool does it.
		icon = {
			texture = "gfx/interface/backgrounds/entry_bg_simple_solid.dds"
			size = { 100% 100% }
			alwaystransparent = yes
		}
		background = { using = entry_bg_simple }

		textbox = {
			text = "MBGA_PANEL_TITLE"
			default_format = "#header"
			position = { 10 8 }
			size = { 280 24 }
		}

		### 1. Who are we demanding from.
		button = {
			text = "MBGA_REFRESH_COUNTRIES"
			using = default_button
			size = { 280 26 }
			position = { 10 34 }
			onclick = "[GetScriptedGui('mbga_refresh_countries').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		scrollarea = {
			position = { 10 64 }
			size = { 280 140 }
			scrollbarpolicy_horizontal = always_off

			scrollbar_vertical = { using = vertical_scrollbar }

			scrollwidget = {
				flowcontainer = {
					direction = vertical
					spacing = 2
					datamodel = "[Country.MakeScope.GetList('mbga_countries')]"

					item = {
						button = {
							text = "MBGA_COUNTRY_ROW"
							using = default_button
							size = { 250 22 }
							onclick = "[GetScriptedGui('mbga_set_target_country').Execute(GuiScope.SetRoot(Scope.GetCountry.MakeScope).AddScope('actor', GetPlayer.MakeScope).End)]"
						}
					}
				}
			}
		}

		### 2. Which of their states. The data context switches to the target country, so
		### Country.AccessStates below lists their states rather than ours.
		textbox = {
			text = "MBGA_PICK_STATE"
			position = { 10 210 }
			size = { 280 20 }
		}

		scrollarea = {
			position = { 10 232 }
			size = { 280 140 }
			scrollbarpolicy_horizontal = always_off
			visible = "[GetScriptedGui('mbga_has_target_country').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			datacontext = "[GetPlayer.MakeScope.Var('mbga_target_country').GetCountry]"

			scrollbar_vertical = { using = vertical_scrollbar }

			scrollwidget = {
				flowcontainer = {
					direction = vertical
					spacing = 2
					datamodel = "[Country.AccessStates]"

					item = {
						button = {
							text = "MBGA_STATE_ROW"
							using = default_button
							size = { 250 22 }
							onclick = "[GetScriptedGui('mbga_open_for_state').Execute(GuiScope.SetRoot(State.MakeScope).AddScope('actor', GetPlayer.MakeScope).End)]"
						}
					}
				}
			}
		}

		textbox = {
			text = "MBGA_TAKEN_COUNT"
			position = { 10 378 }
			size = { 95 20 }
		}

		button = {
			text = "MBGA_STATS_TOGGLE"
			using = default_button
			size = { 100 20 }
			position = { 110 378 }
			onclick = "[GetScriptedGui('mbga_toggle_stats').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		button = {
			text = "MBGA_GOTO_STATE"
			using = default_button
			size = { 74 20 }
			position = { 216 378 }
			datacontext = "[GetPlayer.MakeScope.Var('mbga_active_state').GetState]"
			visible = "[GetScriptedGui('mbga_has_target_country').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			onclick = "[State.ZoomExtraCloseToCapital]"
		}

		scrollarea = {
			position = { 10 402 }
			size = { 280 208 }
			scrollbarpolicy_horizontal = always_off

			scrollbar_vertical = { using = vertical_scrollbar }

			scrollwidget = {
				vbox = {
					spacing = 5
					parentanchor = top|left
					datamodel = "[GetGlobalList('mbga_candidates')]"

					item = {
						hbox = {
							datacontext = "[Scope.GetScriptContainer]"
							spacing = 4

							mbga_province_row = { size = { 226 34 } }
							mbga_province_mark = {}
						}
					}
				}
			}
		}
	}

	# Numbers live in a window of their own, to the side, so that nothing ever covers the
	# province rows.
	window = {
		name = "mbga_stats"
		layer = popups
		allow_outside = yes
		alwaystransparent = no
		movable = yes
		using = clickthrough_blocker

		size = { 250 157 }
		parentanchor = top|right
		position = { -790 80 }
		visible = "[And( GetScriptedGui('mbga_tool_enabled').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('mbga_stats_shown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End) )]"

		icon = {
			texture = "gfx/interface/backgrounds/entry_bg_simple_solid.dds"
			size = { 100% 100% }
			alwaystransparent = yes
		}
		background = { using = entry_bg_simple }

		textbox = {
			text = "MBGA_STATS_TITLE"
			default_format = "#header"
			position = { 10 8 }
			size = { 230 22 }
		}
		textbox = {
			text = "MBGA_STATS_CAND"
			position = { 10 34 }
			size = { 230 18 }
			alwaystransparent = yes
		}
		textbox = {
			text = "MBGA_STATS_PAIRS"
			position = { 10 53 }
			size = { 230 18 }
			alwaystransparent = yes
		}
		textbox = {
			text = "MBGA_STATS_TRANSFERS"
			position = { 10 72 }
			size = { 230 18 }
			alwaystransparent = yes
		}
		textbox = {
			text = "MBGA_STATS_TOUCH"
			position = { 10 91 }
			size = { 230 18 }
			alwaystransparent = yes
		}
		textbox = {
			text = "MBGA_STATS_HOME"
			position = { 10 110 }
			size = { 230 18 }
			alwaystransparent = yes
		}
		textbox = {
			text = "MBGA_STATS_TAKEABLE"
			position = { 10 129 }
			size = { 230 18 }
			alwaystransparent = yes
		}

		# The two answers that were known before they were asked. Both must read no.
		textbox = {
			text = "MBGA_STATS_ORPHANS"
			position = { 10 148 }
			size = { 230 18 }
			alwaystransparent = yes
		}
	}
}
